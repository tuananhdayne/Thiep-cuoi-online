# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Server-only key. REQUIRED before running migration-rls-lockdown.sql, otherwise
# privileged server operations (admin + manage) will fail once RLS is locked.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Long random string used to sign the admin session cookie (HMAC). Set this in
# production. Generate e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: storage bucket name for uploaded images (default: wedding-images)
# NEXT_PUBLIC_SUPABASE_BUCKET=wedding-images
